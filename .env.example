# Neon connection string. Ackto fills this in when you connect a Neon project;
# copy this file to .env when running outside Ackto.
DATABASE_URL=postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/dbname?sslmode=require

# Signs Payload's auth tokens. Any long random string; changing it logs everyone out.
PAYLOAD_SECRET=YOUR_SECRET_HERE
